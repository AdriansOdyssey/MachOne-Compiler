;# 00. Records 
;; Records servem para criar modelos de objetos tipados
record Person(Init, Repr)
    full_name str
    user_age int 
end

let basic_profile = (Person) new: "Alice Smith", 25
show basic_profile ; Person{full_name: "Alice Smith", user_age: 25}
show basic_profile's #full_name ; Alice Smith

;; Apontando métodos à records
record Device(Init, Repr)
    _model_name str ; Atributos privados
    _battery_level int
end

let my_phone = (Device) new: "PhoneX", 85
;; my_phone's #model_name - Erro! atributo privado

;; Você deve usar impl T para implementar métodos à um record
impl Device
    on get_model
        self's #model_name ; self referência a instância do tipo
    end

    on set_model: a_model
        self = self | {#model_name: a_model}
    end
end

(my_phone) get_model ; PhoneX
(my_phone) set_model: "PhoneZ" ; "self = ..." em um impl altera o próprio receptor (mutação in-place)
(my_phone) get_model ; PhoneZ

;# 00. Encapsulamento Automático
;; Property Labels em MachOne definem mensagens que um atributo pode acessar
record SafeUser(Init, Repr, Eq, Prop) ; "Prop" permite usar as labels accessible, readable, etc.
    readable _nickname str        ; getter
    configurable _secret_key str  ; setter
    accessible _login_timeout int ; getter e setter
end

let user_session = (SafeUser) new: "adrian_dev", "key123", 60

(user_session) login_timeout ; 60
(user_session) login_timeout: 120 ; editando para 120

(user_session) nickname ; ok! (readable)
; (user_session) nickname: "_busy_bee" - Erro! (apenas getter)

(user_session) secret_key: "key456" ; ok!
; (user_session) secret_key - Erro! (apenas setter)

;# 00. Métodos "Estáticos"
;; MachOne não tem métodos estáticos como Java ou C++, pois usa de multiple dispatch
;; mas você pode fazer um tipo ser o único receptor de uma mensagem 
record Math end

impl type[Math] ; O tipo "Math" será o único receptor
    on sum: x int, with: y int -> int
        return x + y
    end
end

let res int = (Math) sum: 5 with: 3 ; 8

;# 00. Métodos Mágicos
record User(Prop)
    accessible _name str
    accessible _age int
    accessible _code str
end

; let user = (User) new "Jorge", 18, "abc123" - Erro! record sem método construtor

impl User
    on initialize: [a_name, a_age, a_code] ; método construtor
        self = self | #{name: a_name, age: a_age, code: a_code}
    end
end

let user1 = (User) new: "Jorge", 18, "abc123" ; Ok!
let user2 = (User) new: "Jorge", 18, "abc123"
user1 == user2 ; false - == compara os endereços na memória por padrão 

;; usando o metodo "eq"
impl User
    on eq: other
        return self's #name == other's #name 
               && self's #age == other's #age 
               && self's #code == other's #code
    end
end

@doc 
    Algumas das derivações padrão da linguagem são:
    Init   -> Provê inicialização automática
    Repr   -> Provê uma representação str automática
    Ord    -> Permite fazer operações de ordenação (<=, <, >=, >)
    Eq     -> Permite fazer operações de comparação (==, !=)
    Iter   -> Permite iterar sobre o objeto (for, each, while, etc.)
    Block  -> Permite chamar o objeto como um bloco ((obj) value) 
    Vec    -> Transforma os atributos do objeto em um Vetor
    Proxy  -> Captura mensagens inexistentes enviadas ao objeto
@end

;# 00. Generics
record Box[T](Init)
    _content T
end

impl Box
    on put_item: item -> nil 
        self = self | {#content: item}
    end

    on get_content -> T
        self's #content
    end
end

;; caixa que guarda apenas string
let box_text Box[str] = (Box) new: ""
(box_text) put_item: "Hello, World!"

;; caixa que guarda apenas números
let box_num Box[int] = (Box) new: 0
(box_num) put_item: 42

;; Com tipos diferentes
record Dictionary[K, V](Init)
    _key K
    _value V
end

let dict_nums Dictionary[str, int] = (Dictionary[str, int]) new: "primeiro", 1
let dict_tag Dictionary[tag, int] = (Dictionary) new: #second, 2