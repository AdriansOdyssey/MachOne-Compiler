;# 00. Recursos Funcionais
;; MachOne é uma linguagem orientada à mensagens e estruturada que oferece recursos de linguagens funcionais

;; blocos podem gerar retorno por padrão 
;; basta definir o "do" explicitamente
let grade = 85
let result = if grade >= 90 do
    show "Excelente Desempenho!"
    "Aprovado com A" ; Esse valor será retornado
elsif grade >= 70 do
    show "Bom Trabalho"
    "Aprovado" ; Esse valor será retornado
else do
    show "Precisa estudar mais"
    "Reprovado"
end

;; Operador Ternário
let age = 18
let status = if age >= 18 yield "Maior de idade" else "Menor de Idade" ; você pode omitir os "end" e gerar valor padrão

;; when-is
let x = 5
let status = when x
    is 1, 3, 5, 7, 9 => "X é ímpar!"
    is 2, 4, 6, 8, 10 => "X é Par!"
    default => "Número inválido"
end

show status ; -> X é ímpar!

;; Vector-Comprehensions
let nums = [1, 2, 3, 4, 5]
let new_list = for x in nums yield x*10

show new_list ; -> [10, 20, 30, 40, 50]

;; Com Condicional
let even = for x in 1 to 11 yield x if (x) even?
show even ; -> [2, 4, 6, 8, 10]

;; Objects-Comprehensions
let users = #{ana: 25, bob: 30, charlie: 17}
let adults = for name, age in users yield (name: age) if age >= 18
show adults ; -> {#ana: 25, #bob: 30}