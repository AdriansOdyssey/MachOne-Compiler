;# 00. Actors e Behaviors
;; Actors são implementações de objetos que só podem receber mensagens de forma assíncrona
record MyActor(Init) 
end

behavior MyActor ; usa behavior não impl
    on say_hello
        show "Hello, World!"
    end
end

let my_actor = (MyActor) new
;; (my_actor) say_hello - Erro! envio sincrono
! (my_actor) say_hello ; Ok!
show "Atores são incriveis!"

;; Diferença de Behavior e Impl
impl int ; Cria uma implementação sincrona
    on plus: num
        self + num ; referenciada com "self"
    end
end

(5) plus: 3
! (5) plus: 3 ; O envio pode ser sincrono ou assíncrono

behavior int
    on plus: num
        actor + num ; referenciado com "actor"
    end
end

;; (5) plus: 3 - resulta em erro
! (5) plus: 3 ; Envio só pode ser assíncrono
show "Behaviors vs. Impl"

;# 00. Violações da Semântica Rejeitadas pelo Compilador
let inbox, outbox = (IOBox[int]) new

;; 1. ERRO: Tentar clonar uma Outbox
;; let duplicate = (outbox) copy ; Erro! Outbox não podem ser clonadas.

;; 2. ERRO: Múltiplas tasks tentando consumir a mesma Outbox
;; spawn do
;;     (outbox) receive
;; end
;; spawn do
;;     (outbox) receive ; Erro! Outbox não pode ser compartilhada entre escopos sem transferência explícita de posse.
;; end

record ActorExample(Init)
    _value int
    _inbox inbox[obj[any]]
end

behavior ActorExample
    on tell: msg obj[any] ; quando não queremos gerar valor
        (actor's #inbox) send msg
    end

    on ask: msg obj[any] ; quando queremos gerar valor
        let res_inbbox, res_outbox = (IOBox[any]) new
        (actor's #inbox) send (msg | {#reply_to: res_inbox})
        (res_outbox) receive
    end
end

;; A Outbox processa as mensagens da inbox sequencialmente
spawn do
    (outbox) each |msg| do
        when msg's #type
            is "incremente" =>
                let v = msg's #value
                let actor_ex = actor_ex | {#value: actor_ex's #value + v}
            is "print" =>
                show msg's #text
            is "get_value" =>
                ;; Se a mensagem veio de um 'ask', devolve o valor na Inbox de resposta
                (msg's #reply_to) send actor_ex's #value
            default =>
                show "Mensagem Desconhecida!"
        end
    end
end

;; Criamos o par de comunicação do ator
let inbox, outbox = (IOBox[obj[any]]) new

;; Instanciamos o Ator com sua Inbox pública
let actor_ex = (ActorExample) new: 0, inbox

! (actor_ex) tell: %{type: "incremente" value: 10}
show ? (actor_ex) ask: %{type: "get_value"} ; 10
! (actor_ex) tell: %{type: "print" text: "Olá do Ator!"} ; Olá do Ator!

show "Modelo de Atores é um pattern fantástico!"

@doc
    ;; Comparação com CSP de Golang
    - Use "!" ao invés de "go a_func() ..."
    - Use "spawn do ... end" ao invés "go func(){...}()"
    - Use "?" ao invés waitgroups
    - Use Inboxes e Outboxes ao invés de chan<- e <-chan
    - Não existem channels bidirecionais, ou são receive-only ou send-only
    - Use "(tx) send" e "(rx) receive" ao invés de de "ch <-" e "<- ch"
    - Use "alternate" ao invés de "select"
    - Tasks são goroutines
    - Tasks podem ser atribuidas à variáveis
@end
