;; ==================================================================
;; MachOne Specification File
;; Extensão do Arquivo: .ma
;; ==================================================================

;# 00. Hello World
show "Hello, World!"

;# 00. Comentários
;; Comentário simples de uma linha

@doc
    Bloco de documentação
    de multiplas linhas
@end

;# 00. Binding, Atribuição e Variáveis
let local_var = 200   ; Binding imutável (local)
final max_users = 100 ; Binding imutável (global)
var @mut_var = 1      ; Variável mutável - devem começar com "@"

@mut_var = 2   ; Permitido
show @mut_var  ; -> 2


;# 00. Shadowing e Rebinding
final shadow_bind = "Global Binding"
;; final shadow_bind = "Shadowing Errado" - Erro! 'final' não permite rebinding

on another_scope
    let shadow_bind = "Permitted Shadowing!"
    show shadow_bind ; -> Permitted Shadowing!
end

another_scope ; chama o método (o shadowing só vale dentro dele)
show shadow_bind ; Global Binding

;; variáveis comuns podem fazer rebinding em qualquer escopo
let example = 10
let example = example + 1
show example ; -> 11
;; O compilador enxerga algo como example_1 e example_2 (distintas)

;# 00. Entrada e Saída (I/O)
final input_text = read "Digite algo:\n"
show "Você digitou: " + input_text