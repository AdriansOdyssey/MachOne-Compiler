;# 00. Concorrência
;; MachOne adota um modelo CSP de canal dividido (inbox/outbox), com semântica de posse (ownership)
;; Canais bidirecionais não são suportados
;;
;; Primitivas fundamentais:
;; ! e ?     -> Executa o Dispatch de forma assíncrona
;; spawn     -> Bloco assíncrono (Task)
;; IOBox[T]  -> Tipo fábrica para par de comunicação isolado
;; inbox[T]  -> Extremo de Envio (a entrada do canal, onde você entrega)
;; outbox[T] -> Extremo de Recebimento (a saída do canal, de onde você retira)
;;
;; "!" e "?" só são operadores de dispatch antes de uma mensagem e separados dela por espaço
;; "?:" continua sendo o Elvis e "!=" a comparação

;# 00. Métodos Assíncronos
on send_welcome: email
    show "Enviando boas-vindas para $email"
end

! send_welcome: "ana@mail.com" ; executa de forma assíncrona
show "Main"

;; Dispatches com argumentos
on invoice_total: products, with: shipping
    products + shipping
end

! invoice_total: 120.0 with: 15.0 ; [task at 0xXXXX] - devolve a task e segue sem esperar

;# 00. Blocos Assíncronos (Tasks)
spawn do
    show "Backup iniciado"
end

;; Tasks com retorno tipado, o último tipo é o do retorno
let renderer task[int, str] = spawn |page| do
    "Página $page renderizada"
end

let job = (renderer) result 1 ; [task at 0xXXXX] - devolve a task em andamento, sem esperar

;; Await operator
? invoice_total: 120.0 with: 15.0 ; 135.0 - executa de forma assíncrona e espera o resultado
let rendered = ? (renderer) result 2 ; Página 2 renderizada
let first_page = ? job            ; Página 1 renderizada - também espera uma task já iniciada

;# 00. Anatomia de Canais: Inboxes e Outboxes
;; A fábrica '(IOBox[T]) new' retorna um par tipado [inbox[T], outbox[T]].
let inbox, outbox = (IOBox[int]) new

;; inbox[T]  : Pode ser copiada e compartilhada entre múltiplos processos/tasks
;; outbox[T] : Móvel, mas EXCLUSIVA de um único consumidor

let inbox2 = (inbox) copy ; Permitido: Múltiplos produtores alimentando a mesma Inbox

;; Outbox NÃO implementa a mensagem Copy.
;; let second_outbox = (outbox) copy - ERRO DE COMPILAÇÃO! Outbox é Single-Consumer.

;; Capturar a outbox em uma task move a posse para ela
spawn do
    (outbox) each |n| { show n }
end
;; (outbox) receive - ERRO DE COMPILAÇÃO! A outbox foi movida para a task

;# 00. Comunicação Básica
let inbox, outbox = (IOBox[str]) new

spawn do
    (inbox) send "Usuário ana entrou"
end

let msg = (outbox) receive ; bloqueia até chegar uma mensagem
show msg ; -> Usuário ana entrou

;# 00. Comunicação Múltiplos Produtores
let inbox, outbox = (IOBox[obj[any]]) new

(1..3) each |worker| do
    let local_inbox = (inbox) copy
    spawn do
        (local_inbox) send #{worker: worker, bytes: worker * 512}
    end
end

;; O único consumidor processa as mensagens recebidas na Outbox
(3) times do
    let download = (outbox) receive
    show "Worker $(download's #worker) baixou $(download's #bytes) bytes" ; a ordem pode variar
end

;# 00. Buffers e Capacidade
;; Por padrão, o canal possui capacidade 0 (Unbuffered / Rendezvous): quem envia espera quem recebe.
;; A capacidade é passada como argumento para o método 'new'.

let inbox, outbox = (IOBox[str]) new: 3

(inbox) send "Pedido #1"
(inbox) send "Pedido #2"
(inbox) send "Pedido #3" ; Não bloqueia (Buffer possui espaço)
;; (inbox) send "Pedido #4" - bloquearia até alguém executar "receive"

show (outbox) receive ; -> Pedido #1

;# 00. Fechamento e Ciclo de Vida
let inbox, outbox = (IOBox[str]) new: 1

(inbox) send "Dado Final"
(inbox) close ; Fecha o canal para todas as cópias da inbox

;; Tentativa de envio em canal fechado produz Fail
((inbox) send "Falha") rescue |f| { show "Erro: Inbox Fechada!" }

;; "receive" devolve maybe[T]: nil significa canal fechado e drenado
show (outbox) receive ; -> Dado Final
show (outbox) receive ; -> nil
((outbox) receive) ?: "sem dados" ; sem dados

;# 00. Iteração Exclusiva em Outboxes
let inbox, outbox = (IOBox[str]) new

spawn do
    (1..3) each |i| do
        (inbox) send "linha $i do log"
    end

    (inbox) close
end

(outbox) each |line| do ; termina sozinho quando o canal fecha
    show line
end

;# 00. Seleção com Receive (Multiplexação de Outboxes)
let alert_in, alerts = (IOBox[str]) new: 1
let metric_in, metrics = (IOBox[int]) new: 1

(metric_in) send 42

;; Escolhe o primeiro braço pronto, na ordem em que estão escritos
alternate
    is (alerts) receive msg =>
        show "Alerta: $msg"
    is (metrics) receive value =>
        show "Métrica: $value" ; -> Métrica: 42
    default =>
        show "Nenhuma Outbox pronta"
end

;# 00. Receive em Loops
let job_in, jobs = (IOBox[tag]) new: 2
let quit_in, quit = (IOBox[bool]) new: 1

(job_in) send #resize_image
(job_in) send #send_email
(quit_in) send true

loop do
    alternate ; sem "default" a task espera até algum braço ficar pronto
        is (jobs) receive job =>
            show "Executando: $job"
        is (quit) receive _ =>
            show "Encerrando..."
            break
        is (jobs) closed =>
            show "Fila encerrada"
            break
    end
end
;; -> Executando: #resize_image, Executando: #send_email, Encerrando...

;# 00. Timeouts Orientados a Outbox
;; (Time) after devolve uma outbox que recebe a hora atual quando o tempo passa
let timeout = (Time) after (30) seconds
let pay_in, payments = (IOBox[str]) new

alternate
    is (payments) receive receipt =>
        show "Pagamento confirmado: $receipt"
    is (timeout) receive time =>
        show "Operação expirada em $time"
end

;# 00. Canais em Métodos
;; Cada extremo vai para o método que precisa dele, a outbox muda de dono
let raw_in, raw_out = (IOBox[str]) new: 2
let clean_in, clean_out = (IOBox[str]) new: 2

sign { outbox[str], inbox[str] }
on normalize: raw, into: clean
    (raw) each |sku| { (clean) send ((sku) upcase) }
    (clean) close
end

! normalize: raw_out into: clean_in ; a outbox raw_out é movida para a task

(raw_in) send "ab-1"
(raw_in) send "cd-2"
(raw_in) close

(clean_out) each |sku| { show sku } ; -> AB-1, CD-2

@doc
    # Detalhes Importantes
    - Tasks pendentes são canceladas quando o programa principal termina, para esperar use "?" ou canais
    - "? expr" executa e espera uma mensagem, ou espera o resultado de uma task já iniciada
    - Um Fail dentro de uma task fica guardado até o await, "? job" devolve try[T]
    - Capturar ou passar uma inbox a uma task copia a inbox, e fazer o mesmo com a outbox a move
    - "close" fecha o canal para todas as cópias da inbox, e ele também fecha sozinho quando a última
      cópia da inbox deixa de existir
    - "send" em canal fechado devolve Fail, "receive" em canal fechado e vazio devolve nil
    - "alternate" escolhe o primeiro braço pronto na ordem escrita, "default" roda se nenhum estiver pronto
      e "is (outbox) closed" reage a um canal encerrado
    - Se todas as tasks ficarem esperando, o programa termina com "Erro: deadlock"
@end