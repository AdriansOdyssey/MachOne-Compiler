;# 00. Estruturas de Repetição 
;; while (usando variaveis mutáveis)
var @num = 0
while @num < 5
    show @num
    @num += 1
end

;; until (executa quando falso)
var @countdown = 10
until @countdown == 1 
    show @countdown
    @countdown -= 1
end

;; being-while (não quebra a mutabilidade padrão)
being counter = 0 while counter <= 3 
    show counter 
    let counter = counter + 1
end

;; being-until (executa quando falso)
being counter = 0 until counter > 5
    show counter
    let counter = counter + 1
end

;; for-loop
for i in 1 to 3
    show i
end

;; for-loop sobre objects
let fruits = #{apple: 5.5, banana: 3.2, cherry: 7.3}
for fruit, price in fruits
    show "$fruit: $price:.2"
end

;; each-loop
let item_collection = [10, 20, 30]
(item_collection) each |v| { show v }

;; com objects
(fruits) each |k, v| { show "$k: $v:.2" }

;; times-do
(3) times do
    show "Repetindo..." ; repete 3 vezes
end

;; upto
(1) upto 3 => |step| do
    show step ; 1, 2, 3
end

;; downto
(3) downto 1 => |step| do
    show step ; 3, 2, 1
end

;; Operações com Vetores
let numbers = 1 to 4
let selected_nums = (numbers) select |n| { (n) even? }
let collected_nums = (numbers) collect |n| { n * 10 }
let rejected_nums = (numbers) reject |n| { (n) even? }

;; Você pode usar o operador "&it"
let it_operator = (numbers) select { (&it) even? }
let other_example = (numbers) each { show &it }