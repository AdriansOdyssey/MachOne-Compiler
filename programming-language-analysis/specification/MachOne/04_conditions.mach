;# 00. Estruturas Condicionais
let target_number = 75

;; if-else
if target_number > 50
    show "Maior que 50"
else
    show "Menor ou igual a 50"
end

;; if-elsif-else
if target_number > 80 
    show "Excelente"
elsif target_number > 60 
    show "Bom"
else
    show "Regular"
end

;; unless (executa quando falso)
unless target_number == 100 
    show "Não é 100"
end

;; when-is
let check_day = 2
when check_day
    is 1, 7 => show "Weekend"
    is 2..6 => show "Weekday"
    is x, if x > 7 => show "Inválido" ; usando "if" guard
    default => show "Desconhecido"
end

;; then (orientado à mensagens)
(target_number >= 60) then do
    show "Aprovado via mensagem booleana"
end

;; otherwise (executa quando falso)
(target_number < 10) otherwise do 
    show "Não é menor que 10"
end

;; Combinando os dois
(target_number == 75) then do
    show "Acertou"
otherwise do
    show "Erro"
end

;; sem passar blocos como argumentos
let age = 20
let can_vote = (age >= 18) then "Pode Votar!" otherwise "Não Pode Votar!"