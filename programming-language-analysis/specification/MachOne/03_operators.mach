;# 00. Operadores
;; Matemática
let sum_res = 10 + 5    ; Soma
let sub_res = 20 - 8    ; Subtração
let mult_res = 4 * 3    ; Multiplicação
let div_res = 10 / 3    ; Divisão Float
let floor_res = 10 // 3 ; Divisão Inteira
let mod_res = 10 % 3    ; Resto da Divisão
let power_res = 2 ** 4  ; Potência
let ex_range = 1..5     ; Range de 1 à 5
let in_range = 1 to 5   ; Range de 1 à 4

;; Comparação 
let test_score = 50
test_score == 50 ; Igualdade
test_score != 10 ; Diferente
test_score > 20  ; Maior que
test_score < 100 ; Menor que
test_score >= 50 ; Maior ou igual que
test_score <= 40 ; Menor ou igual que

;; Operador de semelhança
"42" like 42 ; true - compara somente os valores, não os tipos
#ok like "ok"

let long_id long = 5_000_000
let int_id int = 5_000_000

long_id ~ int_id ; true - usando simbolos

;; Operadores Lógicos
let check_and = test_score > 18 and status_on
let check_or = test_score < 18 or status_off
let check_not = not status_on

;; Usando Simbolos
let symbol_and = true && true ; true
let symbol_or = true || false ; true

;; Bitwise
show 3 &&& 5 ; 1  - bitwise and
show 3 ||| 5 ; 7  - bitwise or
show 3 ^^^ 5 ; 6  - bitwise xor
show ~~~7    ; -8 - bitwise not
show 7 <<< 1 ; 14 - left shift
show 7 >>> 1 ; 3  - right shift

;; Resumo (Operadores Lógicos)
;; E lógico -> and / &&
;; OU lógico -> or / ||
;; Não lógico -> not
;; Semelhança -> like / ~
;; E bit-a-bit -> &&&
;; OU bit-a-bit -> |||
;; XOR bit-a-bit -> ^^^
;; NÃO bit-a-bit -> ~~~
;; Deslocar à Esquerda -> <<<
;; Deslocar à Direita -> >>>