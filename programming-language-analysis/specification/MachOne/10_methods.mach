;# 00. Métodos de Despacho
;; Definindo um método unário (apenas chamada)
on store_name
    return "Loja do Rui"
end

show store_name ; -> Loja do Rui

;; return pode ser omitido
on store_slogan
    "Tudo para o seu escritório" ; retorna a última linha por padrão
end

;; Métodos Binários (mensagem e valor)
;; Cada parte da mensagem termina em ":" na definição e na chamada, e as partes são separadas por vírgula
;; O tipo do retorno vem depois de "->", e o bloco abre na quebra de linha (o "=" só serve para uma linha)
on register_customer: customer_name
    "Cliente: $customer_name"
end

show register_customer: "Alex"  ; -> Cliente: Alex
show register_customer "Júlia"  ; -> Cliente: Júlia - ":" pode ser omitido

;; Mensagens com várias partes: cada parte nomeia o argumento que vem depois
;; Definindo Tipos
on line_total: price double, quantity: qty int -> double
    price * qty
end

line_total: 20.0 quantity: 3 ; 60.0

;; Sem tipos o método aceita qualquer valor e o operador decide o que acontece
on subtotal: price, quantity: qty
    price * qty
end

subtotal: 20.0 quantity: 3 ; 60.0
subtotal: "20" quantity: 3 ; 20 20 20 (Resultado Inesperado!)

;; Usando sign
sign { double, int -> double }
on checkout_total: price, quantity: qty
    price * qty
end

checkout_total: 20.0 quantity: 3 ; 60.0 (ok)
checkout_total: "20" quantity: 3 ; Erro! "20" não é double

;# 00. Argumentos Posicionais e Variádicos
;; Elementos Posicionais: vários valores na mesma parte, separados por vírgula
on final_price: [base, discount, tax]
    let discounted = base - discount
    discounted + (discounted * tax)
end

final_price: 100.0, 10.0, 0.1 ; 99.0 - a ordem dos argumentos importa

;; tipando com sign
sign { [double, int] -> double }
on installment: [total, months]
    total / months
end

installment: 1200.0, 12 ; 100.0

;; Argumentos Variádicos (varargs)
on list_items: ...names
    (names) each |name| do
        show "- $name"
    end
end

list_items: "Mouse", "Teclado", "Monitor" ; -> - Mouse, - Teclado, - Monitor

;; os valores chegam como um vetor
on cart_total: ...prices
    var @sum = 0.0
    (prices) each |p| { @sum += p }
    @sum
end

cart_total: 19.9, 5.1, 25.0 ; 50.0

;# 00. Uniões e Tipos Genéricos
;; Union Types
on find_order: key union[str, int]
    "Pedido $key"
end

find_order: 1001   ; OK
find_order: "A-77" ; OK
find_order: true   ; Erro! bool não está na união

;; Usando assinatura
sign { union[str, int] -> str }
on order_status: key
    "Status do pedido $key: enviado"
end

;; Generics
on link_coupon: customer T, with: coupon U ; Aqui T e U podem assumir qualquer tipo
    return "Cliente $customer associado ao cupom $coupon"
end

;; Usando Assinatura
sign { T, U -> str }
on track_visit: user, page: url
    return "Usuário $user visitou $url"
end

link_coupon: 1001 with: 50
link_coupon: "CLI-1001" with: 50
link_coupon: "CLI-1001" with: "BLACK-FRIDAY"

;; Quando os tipos devem ser os mesmos
sign { T, T -> bool }
on matches: value_1, against: value_2
    value_1 == value_2
end

matches "ABC" against "DEF" ; os tipos devem ser os mesmos
matches 123 against 456
matches "foo" against 42    ; Erro! T não pode ser str e int

;; Sobrescrevendo a inferência do compilador
matches 42::long against 42::long ; true - passa a mensagem como sendo long, o padrão seria int

;; tipando o retorno
on add_prices: x double, with: y double -> double
    return x + y
end

;; if guard
on split_bill: total, with: people, if total > 0.0 and people > 0 ; só executa se os dois forem positivos
    return total / people
end

split_bill: 90.0 with: 3 ; 30.0
split_bill: 90.0 with: 0 ; Erro! nenhum método aplicável

;; deinição em uma linha
on vat: price = price * 0.17

vat 100.0 ; 17.0

;; vários guards são testados na ordem da definição, o método sem guard vale para o resto
on shipping: weight, if weight <= 1.0 = 10.0
on shipping: weight, if weight <= 5.0 = 18.0
on shipping: weight = 30.0

show shipping 0.5 ; -> 10.0
show shipping 8.0 ; -> 30.0

;# 00. Implementando Tipos
impl int
    on kilometers
        return self * 1000 ; referenciado com "self"
    end

    on percent_of: total
        return total * self / 100
    end
end

(5) kilometers        ; 5000 - O envio de mensagens é dado por: (data) <messages>
(15) percent_of 200.0   ; 30.0

;; versão inline
impl str on shout
    return ((self) upcase) + "!"
end

impl str on wrap_in: mark
    return mark + self + mark
end

("promo") shout      ; PROMO!
("sale") wrap_in: "*" ; *sale*

@doc
    impl cria algo semelhante à
    obj: self int, kilometers
        return self * 1000
    end

    obj: self int, percent_of: total
        return total * self / 100
    end
@end

;# 00. Lambdas em Métodos
;; lambdas como valor
sign { double, lambda[[double], double] -> double } 
on apply_rule: price, with: rule
    (rule) result price ; executa o lambda
end

apply_rule: 200.0 with: |p| { p * 0.9 } ; 180.0 - executando o lambda

;; lambdas anônimos (blocks)
on with_margin: cost double ; não especificado (anônimo)
    (&block) result cost * 1.25 ; referenciado com &block
end

with_margin 80.0 => |price| ; passado de forma anônima com o operador "=>"
    show "Preço de venda: $price" ; -> Preço de venda: 100.0
end

;; inline
with_margin: 40.0 =>|price| { show price } ; -> 50.0

@doc
    # Detalhes Importantes
    - Partes de mensagem não podem ser palavras reservadas: to e by (ranges), and, or, not, like, obj
    - Cada argumento vai até a próxima parte da mensagem ou o fim da linha, use parênteses para compor
    - Mesmo nome com tipos ou guards diferentes forma um despacho múltiplo, o mais específico vence
    - Sem método aplicável é erro de compilação, ou Fail se o tipo só é conhecido na chamada
    - Valores posicionais na mesma parte usam colchetes: on final_price: [base, discount, tax] e final_price: [100.0, 10.0, 0.1]
    - Use sign ou os tipos na definição, nunca os dois no mesmo método
    - "&block" é o bloco do método mais próximo, mesmo dentro de outros blocos
@end