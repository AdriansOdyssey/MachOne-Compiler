;# 00. Vetores 
let name_list = ["John", "Mary", "Bob"]
let point_scores vec[int] = [20, 30, 40]     ; Tipando
let alt_syntax = (Vector) new: [1, 2, 3, 4]        ; Sintaxe Alternativa
let out_comma = %["A Vector" "without" "comma"] ; Sem virgula para separar valores 

;; Acessando elementos
(point_scores) element_at 0 ; 20
(point_scores) first        ; 20 - pega o primeiro elemento
(point_scores) last         ; 40 - pega o último elemento
(point_scores) length       ; 3 

;; Usando Quote-Operators
name_list'nth 0     ; John - pega pelo indice
name_list'nth 1     ; Mary 
name_list'nth -1    ; Bob - pega o último elemento
name_list'nth 0..1  ; ["John", "Mary"]
name_list'head      ; John - pega o primeiro elemento
name_list'tail      ; ["Mary", "Bob"] - pega todos menos o primeiro elemento

;; Adicionando Elementos 
let name_list = (name_list) append "Liam"            ; Adiciona no final
let name_list = (name_list) unshift "Kennedy"        ; Adiciona no inicio
let name_list = (name_list) push "Nathan", "Kenan"   ; Adiciona mais de um item no final
let name_list = (name_list) insert "Emma" at 3       ; Adiciona em uma posição especifica
let name_list = (name_list) merge "Jorge", "William" ; Adiciona mais de um elemento 

;; Você pode usar os operadores de append "<<" ou concatenação "+"
let name_list = name_list << "Smith"           ; Adiciona no final
let name_list = "Sophia" >> name_list          ; Adiciona no inicio
let name_list = name_list + ["Mateo", "David"] ; Concatenação
let greet = "Hello, " + "World!"

;; Removendo Elementos
let name_list = (name_list) pop             ; Remove o último elemento
let name_list = (name_list) shift           ; Remove o primeiro elemento
let name_list = (name_list) delete "David"  ; Remove todas as ocorrências do valor "David"
let name_list = (name_list) delete_nth 0    ; Remove pelo indice

;; Usando o operador de remoção
let name_list = name_list \\ "David"

;; Conferindo se o vetor tem um ou mais itens (has?, has_all? e has_any?)
(name_list) has? "Jorge" ; Confere se tem a ocorrências, retorna true ou false
(name_list) has_all? "David", "Mateo", "Sophia" ; Confere se tem todos e retorna true ou false
(name_list) has_any? "Smith", "Hello", "World"  ; Confere se tem algum e retorna true ou false

;; Ranges (Vetores Númericos)
let range_vector = 1 to 6      ; [1, 2, 3, 4, 5] - Range exclusivo
let step_vector = 1 to 10 by 2 ; [1, 3, 5, 7, 9]
let down_vector = 5 to 1 by -1 ; [5, 4, 3, 2] - o limite final também é exclusivo
let inclusive_vec = 1..5       ; [1, 2, 3, 4, 5] - Range inclusivo

@doc 
    # Vetor: RRB-Vector

    Vetores são imutáveis e persistentes: toda operação devolve um novo
    vetor que compartilha estrutura com o anterior. Não são arrays
    contíguos nem arrays de referências, são RRB-Trees (Relaxed Radix
    Balanced Trees), tries de até 32 vias.

    - Estrutura: count, shift, root (nós de até 32 filhos), um buffer
      no início (head) e outro no fim (tail), cada um com até 32
      elementos.
    - Nós regulares usam índice por bits (5 bits por nível). Nós
      relaxados, criados por concatenação, inserção e remoção no meio,
      guardam uma tabela de tamanhos acumulados para localizar o filho.
    - Acesso por índice: O(log32 n), na prática O(1). `length` é O(1).
    - Escrita: copia só o caminho até a folha (path copying) e
      compartilha o resto.
    - O(1) amortizado: `<<`, `append`, `push`, `pop` (no tail), e
      `>>`, `unshift`, `shift` (no head).
    - O(log n): `+`, `merge`, `insert .. at`, `delete_nth`.
    - O(n): `has?`, `delete valor` e `\\`, que precisam procurar o
      valor.
    - `vec[T]` é só checagem estática e não altera a estrutura.
@end